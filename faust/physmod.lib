// Building blocks for the instruments ported from
// reference/physicalmodeling/synth.ts (pmdrums, pmbass, pmguitar, pmpiano,
// pmstrings, pmbrass). Each is written out to behave like its AssemblyScript
// original rather than taken from the Faust libraries, so a port sounds the
// same whichever Faust compiler builds it. Redesigning the waveguide here
// changes every instrument that imports it.
import("stdfaust.lib");

// MIDI note number back from freq (freq is the only carrier of the note).
notenum(freq) = 12 * log(freq / 440) / log(2) + 69;
key(freq) = int(notenum(freq) + 0.5);

// The original's Noise: uniform in [-0.5, 0.5). no.multinoise gives each
// waveguide its own stream, as the original's shared generator effectively did.
noise = no.noise * 0.5;
noises(n, i) = no.multinoise(n) : ba.selector(i, n) : *(0.5);

// Linear ADSR, as synth/envelope.class.ts: attack ramps from the current value,
// release ramps down from wherever it is. State 0 = release/idle, 1 attack,
// 2 decay, 3 sustain.
adsr(at, dt, sl, rt, g) = step ~ (_, _) : (!, _)
with {
    step(st, v) = st2, v2
    with {
        s0 = ba.if(g > g', 1, ba.if(g < g', 0, st));
        va = min(1, v + 1 / max(1, at * ma.SR));
        vd = max(sl, v - 1 / max(1, dt * ma.SR));
        vr = max(0, v - 1 / max(1, rt * ma.SR));
        v2 = ba.selectn(4, s0, vr, va, vd, v);
        st2 = ba.selectn(4, s0, 0, ba.if(va >= 1, 2, 1), ba.if(vd <= sl, 3, 2), 3);
    };
};

// One-shot attack/decay from 0 on each trigger (the waveguide exciter's
// Envelope(att, dec, 0, dec): its value is reset to 0 on start and it is never
// released). State 0 idle, 1 attack, 2 decay.
ad(at, dt, trig) = step ~ (_, _) : (!, _)
with {
    step(st, v) = st2, v2
    with {
        s0 = ba.if(trig, 1, st);
        va = min(1, ba.if(trig, 0, v) + 1 / max(1, at * ma.SR));
        vd = max(0, v - 1 / max(1, dt * ma.SR));
        v2 = ba.selectn(3, s0, v, va, vd);
        st2 = ba.selectn(3, s0, 0, ba.if(va >= 1, 2, 1), 2);
    };
};

// RBJ cookbook biquads at Butterworth Q, as synth/biquad.ts (cutoff clamped to
// SR/2 - 1000 like the original), in direct form I like the original: fi.tf2
// is direct form II, which reacts differently to a per-sample cutoff sweep.
df1(b0, b1, b2, a1, a2) = ff : + ~ fb
with {
    ff(x) = b0 * x + b1 * x' + b2 * x'';
    fb(y) = 0 - a1 * y - a2 * y';
};
rbj(hp, fc) = df1(b0 / a0, b1 / a0, b0 / a0, -2 * c / a0, (1 - al) / a0)
with {
    w = 2 * ma.PI * min(fc, ma.SR / 2 - 1000) / ma.SR;
    c = cos(w);
    al = sin(w) / (2 * 0.7071067811865475);
    a0 = 1 + al;
    b0 = ba.if(hp, (1 + c) * 0.5, (1 - c) * 0.5);
    b1 = ba.if(hp, 0 - (1 + c), 1 - c);
};
lp(fc) = rbj(0, fc);
hpf(fc) = rbj(1, fc);
bandpass(lo, hi) = hpf(lo) : lp(hi);

// The original's OnePole low-pass: z = x * (1 - b1) + z * b1.
onepole(fc, x) = f ~ _
with {
    b1 = exp(-2 * ma.PI * fc / ma.SR);
    f(z) = x * (1 - b1) + z * b1;
};

// First-order allpass (the fractional part of the delay): y = c(x - y') + x'.
allpass1(c, x) = f ~ _
with {
    f(y) = c * (x - y) + x';
};

// synth/clip.ts softclip.
softclip(x) = ba.if(x > 1, 2.0 / 3, ba.if(x < -1, -2.0 / 3, x - x * x * x / 3));

// The original's WaveGuide: noise exciter -> [ + delay(SR/freq) -> one-pole LP ]
// -> feedback. The delay is an integer delay plus allpass1 for the fraction; the
// loop's LP delay is not compensated, so pitch sits a little flat (that is the
// original's sound). Output is the loop signal after the LP.
//
// Like the original, it has two delay lines that swap roles on each note: the
// new note starts on the other line, while the previous string keeps ringing on
// its own line as a plain comb (feedback 0.9, no filter). Each line keeps the
// length and filter it was started with.
//
// The original clears both lines (stop()) once the voice envelope has released;
// `kill` does the same here: zero feedback while the voice is silent, so a
// reused voice starts from a quiet string.
//
//   excAtt, excDec  exciter envelope (s)      excFc  exciter low-pass (Hz)
//   fbLevel         loop feedback             fbFc   loop low-pass (Hz), sampled at note-on
//   exc             exciter noise signal      kill   1 while the voice is silent
waveguide(excAtt, excDec, excFc, fbLevel, fbFc, freq, gate, exc, kill) = lineA + lineB
with {
    trig = gate > gate';
    parity = trig : (xor ~ _);                   // flips on each note-on
    excite = exc * ad(excAtt, excDec, trig) : onepole(excFc);

    line(me) = body ~ (de.delay(8192, n - 1) : allpass1(c)) : (!, _)
    with {
        start = trig & (parity == me);
        len = ba.sAndH(start, ma.SR / freq);
        n = max(1, int(len));
        d = max(0, len - n);
        c = (1 - d) / (1 + d);
        fc = ba.sAndH(start, fbFc);
        active = parity == me;
        body(read) = w, out
        with {
            s = onepole(fc, excite * active + read);
            w = ba.if(kill, 0, ba.if(active, s * fbLevel, read * 0.9));
            out = ba.if(active, s, read);
        };
    };
    lineA = line(1);
    lineB = line(0);
};

// Loop feedback from the original's value and a `damping` tweak (1 = original).
// Exponential, so the slider has a musical range whatever the original loss:
// each 0.5 multiplies the loss (1 - feedback) by 10.
damped(fb0, d) = max(0, 1 - (1 - fb0) * pow(100, d - 1));

// A voice envelope that has finished its release: the original's stop().
silent(gate, env) = (gate == 0) & (env <= 0);
