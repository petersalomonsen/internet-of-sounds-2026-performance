osc(n) = table, int(ph) : rdtable
with {
    fn = 440 * pow(2, (note + spread * (n - 4) - 69) / 12);
    // a random start phase per oscillator, then 2048 * f / SR per sample
    ph = (+(2048 * fn / SR) : wrap) ~ _ : +(start) : wrap;
    start = ba.sAndH(1 - 1', (noises(9, n) + 0.5) * 2048);
};
wrap(x) = x - 2048 * floor(x / 2048);
// oscillator n: left weight floor(n/2) + 0.5, right floor((9-n)/2) + 0.5
lw(n) = int(n / 2) + 0.5;
rw(n) = int((9 - n) / 2) + 0.5;
left = sum(n, 9, osc(n) * lw(n));
right = sum(n, 9, osc(n) * rw(n));

// x4: a Faust voice lands at 0.25 per side (the original adds 1.0).
process = left * env * level * 4, right * env * level * 4;

// Channel effect (PadSynthChannel): x 0.04, then a 4 kHz low-pass, Q 0.3.
tone = 4000 * hslider("tone[midi:ctrl 1]", 1, 0.02, 2.56, 0.02);
effect = par(i, 2, *(0.04) : df1(0, 0, tone, 0.3));
