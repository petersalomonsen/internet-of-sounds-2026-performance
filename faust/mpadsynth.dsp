// Pad synth from "monster is close" (reference/monstertheme/synth.ts, PadSynth
// + PadSynthChannel): nine oscillators, detuned in 0.04-semitone steps and
// fanned across left/right, reading one 2048-sample wavetable (1022 harmonics,
// built in the original by an inverse FFT - embedded here as computed there),
// a 2.5 s decay; on the channel a gain and a soft 4 kHz low-pass.
import("monster.lib");

freq = hslider("freq", 261.63, 20, 20000, 0.01);
gate = button("gate");
gain = hslider("gain", 0.8, 0, 1, 0.01);

// Live tweaks (1 = original)
spread = 0.04 * hslider("spread", 1, 0.02, 2.56, 0.02);  // detune step between the oscillators (semitones)

env = adsr(0.001, 2.5, 0.0, 0.2, gate);
note = notenum(freq);
// the original's level: velocity / 100, scaled by 1 - 1/(f - 200)
level = gain * 127 / 100 * (1 - 1 / (freq - 200));

